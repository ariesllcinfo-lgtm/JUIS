---
// src/pages/admin/survey-results.astro
//
// 適性診断の結果を可視化する簡易ダッシュボード。
// 必ず Cloudflare Access 等でこのパス（/admin/*）と
// /api/admin/* を保護してから公開してください（SETUP.md参照）。
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="適性診断ダッシュボード"
  description="学部診断の回答状況を確認する管理画面です。"
>
  <section class="bg-light py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-serif font-bold text-primary mb-8">
        適性診断ダッシュボード
      </h1>

      <div id="loading" class="text-gray-500">読み込み中…</div>
      <div id="error" hidden class="text-red-600"></div>

      <div id="content" hidden class="space-y-10">
        <!-- 総数 -->
        <div class="bg-white rounded-xl shadow-md p-8">
          <p class="text-sm text-gray-500 mb-1">総回答数</p>
          <p id="total-count" class="text-5xl font-serif font-bold text-primary"></p>
        </div>

        <!-- 学部別診断結果 -->
        <div class="bg-white rounded-xl shadow-md p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-6">診断結果（学部別）</h2>
          <div id="faculty-chart" class="space-y-3"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- 学歴別 -->
          <div class="bg-white rounded-xl shadow-md p-8">
            <h2 class="text-xl font-bold text-gray-900 mb-6">学歴別</h2>
            <div id="education-chart" class="space-y-3"></div>
          </div>

          <!-- 職業別 -->
          <div class="bg-white rounded-xl shadow-md p-8">
            <h2 class="text-xl font-bold text-gray-900 mb-6">職業別</h2>
            <div id="occupation-chart" class="space-y-3"></div>
          </div>
        </div>

        <!-- 直近の回答 -->
        <div class="bg-white rounded-xl shadow-md p-8 overflow-x-auto">
          <h2 class="text-xl font-bold text-gray-900 mb-6">直近の回答（最新20件）</h2>
          <table class="w-full text-sm text-left">
            <thead>
              <tr class="border-b border-gray-200 text-gray-500">
                <th class="py-2 pr-4">日時</th>
                <th class="py-2 pr-4">診断結果</th>
                <th class="py-2 pr-4">学歴</th>
                <th class="py-2 pr-4">職業</th>
              </tr>
            </thead>
            <tbody id="recent-table"></tbody>
          </table>
          <p class="text-xs text-gray-400 mt-4">
            ※ メールアドレスや自由記述欄はここには表示していません。
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const FACULTY_COLORS: Record<string, string> = {
    情報法経学部: "#1e3a8a",
    社会福祉学部: "#b45253",
    知的財産商学部: "#8a6d3b",
    コミュニケーション保障学部: "#2f6f6f",
    システム農学部: "#3f6b34",
    "College of Design": "#6b3f8a",
  };

  interface Bucket {
    label: string;
    count: number;
  }

  interface Summary {
    total: number;
    byFaculty: Bucket[];
    byEducation: Bucket[];
    byOccupation: Bucket[];
    recent: {
      created_at: string;
      personality_type: string | null;
      education: string | null;
      occupation: string | null;
    }[];
  }

  function renderBars(
    containerId: string,
    buckets: Bucket[],
    colorFor: (label: string) => string
  ) {
    const container = document.getElementById(containerId)!;
    if (buckets.length === 0) {
      container.innerHTML =
        '<p class="text-sm text-gray-400">まだデータがありません。</p>';
      return;
    }
    const max = Math.max(...buckets.map((b) => b.count));
    container.innerHTML = buckets
      .map((b) => {
        const pct = max > 0 ? Math.round((b.count / max) * 100) : 0;
        const color = colorFor(b.label);
        return `
          <div>
            <div class="flex justify-between text-sm text-gray-700 mb-1">
              <span>${b.label}</span>
              <span class="text-gray-400">${b.count}件</span>
            </div>
            <div class="h-2.5 rounded-full bg-gray-100">
              <div class="h-2.5 rounded-full" style="width:${pct}%; background-color:${color}"></div>
            </div>
          </div>
        `;
      })
      .join("");
  }

  function formatDate(iso: string): string {
    // D1のdatetime('now')はUTC。日本向け表示として+9時間して整形。
    const d = new Date(iso.replace(" ", "T") + "Z");
    const jst = new Date(d.getTime() + 9 * 60 * 60 * 1000);
    const pad = (n: number) => String(n).padStart(2, "0");
    return `${jst.getFullYear()}/${pad(jst.getMonth() + 1)}/${pad(jst.getDate())} ${pad(jst.getHours())}:${pad(jst.getMinutes())}`;
  }

  async function load() {
    const loadingEl = document.getElementById("loading")!;
    const errorEl = document.getElementById("error")!;
    const contentEl = document.getElementById("content")!;

    try {
      const res = await fetch("/api/admin/summary");
      if (!res.ok) throw new Error("fetch_failed");
      const data: Summary = await res.json();

      document.getElementById("total-count")!.textContent = `${data.total}件`;

      renderBars("faculty-chart", data.byFaculty, (label) => FACULTY_COLORS[label] ?? "#1e3a8a");
      renderBars("education-chart", data.byEducation, () => "#3b82f6");
      renderBars("occupation-chart", data.byOccupation, () => "#3b82f6");

      const tbody = document.getElementById("recent-table")!;
      tbody.innerHTML = data.recent
        .map(
          (r) => `
            <tr class="border-b border-gray-100">
              <td class="py-2 pr-4 text-gray-500">${formatDate(r.created_at)}</td>
              <td class="py-2 pr-4">${r.personality_type ?? "-"}</td>
              <td class="py-2 pr-4">${r.education ?? "-"}</td>
              <td class="py-2 pr-4">${r.occupation ?? "-"}</td>
            </tr>
          `
        )
        .join("");

      loadingEl.hidden = true;
      contentEl.hidden = false;
    } catch (err) {
      loadingEl.hidden = true;
      errorEl.hidden = false;
      errorEl.textContent =
        "データの取得に失敗しました。時間をおいて再度お試しください。";
    }
  }

  load();
</script>
