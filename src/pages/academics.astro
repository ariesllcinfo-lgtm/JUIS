---
import Layout from "../layouts/Layout.astro";
import { createClient } from "microcms-js-sdk";

const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

let articles = [];
try {
  const res = await client.get({
    endpoint: "articles",
    queries: { limit: 100 },
  });
  articles = res.contents;
} catch (error) {
  console.error("articlesの取得に失敗しました", error);
}

const departments = articles.filter((a) => a.type?.includes("学部概要"));
const graduateSchools = articles.filter((a) => a.type?.includes("大学院概要"));
---

<Layout title="学部・大学院" description="城北情報大学の学部・大学院をご紹介します。">
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">

  <!-- 学部 -->
  <section class="mb-24">
    <h1 class="text-3xl font-serif font-bold text-primary mb-10 border-b pb-4">学部</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {departments.map((d) => (
        <a href={`/articles/${d.id}/`} class="block bg-white rounded-lg shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow">
          <h2 class="text-lg font-bold text-gray-900">{d.title}</h2>
        </a>
      ))}
      {departments.length === 0 && <p class="text-gray-500 col-span-full">準備中です。</p>}
    </div>
  </section>

  <!-- 大学院 -->
  <section>
    <h2 class="text-3xl font-serif font-bold text-primary mb-10 border-b pb-4">大学院</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {graduateSchools.map((g) => (
        <a href={`/articles/${g.id}/`} class="block bg-white rounded-lg shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow">
          <h2 class="text-lg font-bold text-gray-900">{g.title}</h2>
        </a>
      ))}
      {graduateSchools.length === 0 && <p class="text-gray-500 col-span-full">準備中です。</p>}
    </div>
  </section>

</div>
</Layout>

