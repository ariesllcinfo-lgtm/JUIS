---
import Layout from "../../layouts/Layout.astro";
import { getArticles } from "../../lib/articles";

const newsItems = (await getArticles()).filter((a) => a.type?.includes("News"));

function formatDate(dateStr) {
  return new Date(dateStr)
    .toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" })
    .replace(/\//g, ".");
}
---

<Layout title="お知らせ一覧" description="城北情報大学からのお知らせ一覧です。">
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
<h1 class="text-3xl font-serif font-bold text-primary mb-10 border-b pb-4">News</h1>
<div class="divide-y divide-gray-200">
{newsItems.map((item) => (
<a href={`/news/${item.id}/`} class="block py-6 hover:bg-gray-50 transition -mx-4 px-4">
<time class="text-sm text-gray-500 font-medium">{formatDate(item.publishedAt)}</time>
<h2 class="text-lg font-bold text-gray-900 mt-1">{item.title}</h2>
</a>
))}
{newsItems.length === 0 && <p class="text-gray-500 py-10">現在お知らせはありません。</p>}
</div>
</div>
</Layout>
