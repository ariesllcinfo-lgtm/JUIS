---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getArticles, isGeneralArticle } from "../../lib/articles";
const articles = (await getArticles()).filter(isGeneralArticle);
---
<Layout title="記事一覧" description="城北情報大学の記事・コラム・活動レポートをお届けします。">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
    <nav aria-label="パンくず" class="text-sm text-gray-500 mb-6"><a href="/" class="hover:underline">ホーム</a> / <span aria-current="page">記事一覧</span></nav>
    <h1 class="text-3xl md:text-4xl font-serif font-bold text-primary mb-4">記事一覧</h1>
    <p class="text-gray-600 mb-10">コラムや活動レポートなど、さまざまな記事をお届けします。</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {articles.map((item) => <ArticleCard item={item} />)}
      {articles.length === 0 && <p class="col-span-full text-gray-500 py-10">現在、公開されている記事はありません。</p>}
    </div>
  </div>
</Layout>
