---
// src/pages/about/recruitment.astro
import Layout from "../../layouts/Layout.astro";
import { createClient } from "microcms-js-sdk";

const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

let jobs = [];
try {
  const res = await client.get({
    endpoint: "articles",
    queries: { limit: 100 },
  });
  jobs = res.contents
    .filter((a) => a.type?.includes("教員募集"))
    .sort((a, b) => (a.deadline ?? "").localeCompare(b.deadline ?? ""));
} catch (error) {
  console.error("articlesの取得に失敗しました", error);
}

const today = new Date().toISOString().slice(0, 10);
function isExpired(deadline) {
  return !!deadline && deadline < today;
}
---

<Layout title="教員採用情報" description="城北情報大学の教員公募情報です。">
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <h1 class="text-3xl font-serif font-bold text-primary mb-4 border-b pb-4">教員採用情報</h1>
  <p class="text-gray-600 mb-10">本学で教育・研究に携わっていただける教員を募集しています。</p>

  <div class="divide-y divide-gray-200">
    {jobs.map((job) => (
      <a
        href={`/articles/${job.id}/`}
        class={`block py-6 hover:bg-gray-50 transition -mx-4 px-4 ${isExpired(job.deadline) ? "opacity-50" : ""}`}
      >
        <div class="flex justify-between items-baseline flex-wrap gap-2">
          <h2 class="text-lg font-bold text-gray-900">{job.title}</h2>
          {isExpired(job.deadline) && (
            <span class="text-xs text-gray-400 border border-gray-300 rounded px-2 py-0.5">募集終了</span>
          )}
        </div>
        <p class="text-sm text-gray-500 mt-1">
          {job.faculty}
          {job.employment_type ? ` ／ ${job.employment_type}` : ""}
          {job.deadline ? ` ／ 応募締切：${job.deadline}` : ""}
        </p>
      </a>
    ))}
    {jobs.length === 0 && <p class="text-gray-500 py-10">現在募集中の求人はありません。</p>}
  </div>
</div>
</Layout>
