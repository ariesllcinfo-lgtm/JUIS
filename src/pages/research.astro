---

<Layout title="教育・研究" description="教員紹介・出版物紹介・附属機関をご紹介します。">
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">

  <!-- 教員紹介 -->
  <section class="mb-24">
    <h1 class="text-3xl font-serif font-bold text-primary mb-10 border-b pb-4">教員紹介</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {faculty.map((f) => (
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6">
          <div class="flex items-baseline gap-2 mb-1">
            <h3 class="text-lg font-bold text-gray-900">{f.name}</h3>
            <span class="text-sm text-gray-500">{f.title}</span>
          </div>
          <p class="text-xs text-secondary font-medium mb-3">{f.department}</p>
          <p class="text-sm font-bold text-gray-700 mb-2">{f.specialty}</p>
          <p class="text-sm text-gray-600 leading-relaxed">{f.bio}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 出版物紹介 -->
  <section class="mb-24">
    <h2 class="text-3xl font-serif font-bold text-primary mb-10 border-b pb-4">出版物紹介</h2>
    <div class="divide-y divide-gray-200">
      {publications.map((p) => (
        <div class="py-6">
          <p class="text-xs text-gray-500 font-medium mb-1">{p.venue}（{p.year}）</p>
          <h3 class="text-lg font-bold text-gray-900 mb-1">{p.title}</h3>
          <p class="text-sm text-gray-600">{p.authors}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 附属機関 -->
  <section>
    <h2 class="text-3xl font-serif font-bold text-primary mb-10 border-b pb-4">附属機関</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {institutes.map((i) => (
        <div class="border-l-4 border-secondary pl-6">
          <h3 class="text-lg font-bold text-gray-900 mb-2">{i.name}</h3>
          <p class="text-sm text-gray-600 leading-relaxed">{i.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <p class="text-xs text-gray-400 mt-16">※ このページの内容はすべて仮のサンプルです。実際の情報に差し替えてください。</p>
</div>
</Layout>
