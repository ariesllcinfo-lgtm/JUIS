---
import Layout from "../layouts/Layout.astro";
import { createClient } from "microcms-js-sdk";

const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

let faculty = [];
let publications = [];
let institutes = [];
try {
  const res = await client.get({
    endpoint: "articles",
    queries: { limit: 100 },
  });
  faculty = res.contents.filter((a) => a.type?.includes("教員紹介"));
  publications = res.contents.filter((a) => a.type?.includes("出版物"));
  institutes = res.contents.filter((a) => a.type?.includes("附属機関"));
} catch (error) {
  console.error("articlesの取得に失敗しました", error);
}
---

<Layout title="教育・研究" description="教員紹介・出版物紹介・附属機関をご紹介します。">
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">

  <!-- 教員紹介 -->
  <section class="mb-24">
    <div class="flex justify-between items-end mb-10 border-b pb-4">
      <h1 class="text-3xl font-serif font-bold text-primary">教員紹介</h1>
      <a class="text-sm font-medium text-secondary hover:underline" href="/faculty/">一覧を見る →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {faculty.map((f) => (
        <a href={`/articles/${f.id}/`} class="block bg-white rounded-lg shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow">
          <div class="flex items-baseline gap-2 mb-1">
            <h3 class="text-lg font-bold text-gray-900">{f.title}</h3>
            {f.position && <span class="text-sm text-gray-500">{f.position}</span>}
          </div>
          {f.faculty && <p class="text-xs text-secondary font-medium mb-3">{f.faculty}</p>}
          {f.specialty && <p class="text-sm font-bold text-gray-700">{f.specialty}</p>}
        </a>
      ))}
      {faculty.length === 0 && <p class="text-gray-500 col-span-full">準備中です。</p>}
    </div>
  </section>

  <!-- 出版物紹介 -->
  <section class="mb-24">
    <h2 class="text-3xl font-serif font-bold text-primary mb-10 border-b pb-4">出版物紹介</h2>
    <div class="divide-y divide-gray-200">
      {publications.map((p) => (
        <a href={`/articles/${p.id}/`} class="block py-6 hover:bg-gray-50 transition -mx-4 px-4">
          <p class="text-xs text-gray-500 font-medium mb-1">
            {p.venue}{p.year ? `（${p.year}）` : ""}
          </p>
          <h3 class="text-lg font-bold text-gray-900 mb-1">{p.title}</h3>
          {p.authors && <p class="text-sm text-gray-600">{p.authors}</p>}
        </a>
      ))}
      {publications.length === 0 && <p class="text-gray-500 py-10">準備中です。</p>}
    </div>
  </section>

  <!-- 附属機関 -->
  <section>
    <div class="flex justify-between items-end mb-10 border-b pb-4">
      <h2 class="text-3xl font-serif font-bold text-primary">附属機関</h2>
      <a class="text-sm font-medium text-secondary hover:underline" href="/institutes/">一覧を見る →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {institutes.map((i) => (
        <a href={`/articles/${i.id}/`} class="block border-l-4 border-secondary pl-6 hover:bg-gray-50 transition py-2">
          <h3 class="text-lg font-bold text-gray-900 mb-2">{i.title}</h3>
        </a>
      ))}
      {institutes.length === 0 && <p class="text-gray-500 col-span-full">準備中です。</p>}
    </div>
  </section>

</div>
</Layout>
