---
// src/pages/students/board.astro
import StudentLayout from "../../layouts/StudentLayout.astro";
---

<StudentLayout title="掲示板" description="城北情報大学の学生専用掲示板です。">
  <h1 class="text-3xl font-serif font-bold text-primary mb-2">掲示板</h1>
  <p class="text-gray-600 mb-10">学生同士で自由に投稿・閲覧できる掲示板です。</p>

  <div class="bg-white rounded-xl shadow-md p-6 mb-10">
    <form id="post-form" class="space-y-4">
      <div>
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">タイトル</label>
        <input
          type="text"
          id="title"
          name="title"
          required
          maxlength="100"
          class="w-full border border-gray-300 rounded px-3 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-secondary"
        />
      </div>
      <div>
        <label for="body" class="block text-sm font-medium text-gray-700 mb-1">本文</label>
        <textarea
          id="body"
          name="body"
          required
          rows="4"
          maxlength="2000"
          class="w-full border border-gray-300 rounded px-3 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-secondary"
        ></textarea>
      </div>
      <button
        type="submit"
        id="post-submit"
        class="bg-primary hover:bg-blue-800 text-white font-bold py-2 px-6 rounded transition duration-300 disabled:opacity-60 disabled:cursor-not-allowed"
      >
        投稿する
      </button>
      <p id="post-error" role="alert" hidden class="text-sm text-red-600"></p>
    </form>
  </div>

  <div id="posts">読み込み中…</div>
</StudentLayout>

<script>
  interface Post {
    id: number;
    student_email: string;
    title: string;
    body: string;
    created_at: string;
  }

  function escapeHtml(s: string): string {
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  function formatDate(iso: string): string {
    // D1のdatetime('now')はUTC。日本向け表示として+9時間して整形。
    const d = new Date(iso.replace(" ", "T") + "Z");
    const jst = new Date(d.getTime() + 9 * 60 * 60 * 1000);
    const pad = (n: number) => String(n).padStart(2, "0");
    return `${jst.getFullYear()}/${pad(jst.getMonth() + 1)}/${pad(jst.getDate())} ${pad(jst.getHours())}:${pad(jst.getMinutes())}`;
  }

  async function loadPosts() {
    const el = document.getElementById("posts")!;
    try {
      const res = await fetch("/api/students/board");
      if (!res.ok) throw new Error("fetch_failed");
      const data: { posts: Post[] } = await res.json();

      if (data.posts.length === 0) {
        el.innerHTML = '<p class="text-sm text-gray-400">まだ投稿はありません。</p>';
        return;
      }

      el.innerHTML = data.posts
        .map(
          (p) => `
            <div class="bg-white rounded-xl shadow-md p-6 mb-4">
              <div class="flex justify-between items-baseline mb-2 flex-wrap gap-2">
                <h2 class="text-lg font-bold text-gray-900">${escapeHtml(p.title)}</h2>
                <span class="text-xs text-gray-400">${formatDate(p.created_at)}</span>
              </div>
              <p class="text-gray-700 whitespace-pre-wrap mb-3">${escapeHtml(p.body)}</p>
              <p class="text-xs text-gray-400">${escapeHtml(p.student_email)}</p>
            </div>
          `
        )
        .join("");
    } catch {
      el.innerHTML = '<p class="text-sm text-red-500">投稿の取得に失敗しました。</p>';
    }
  }

  const form = document.getElementById("post-form") as HTMLFormElement;
  const submitBtn = document.getElementById("post-submit") as HTMLButtonElement;
  const errorEl = document.getElementById("post-error")!;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    errorEl.hidden = true;

    const data = new FormData(form);
    const title = String(data.get("title") ?? "").trim();
    const body = String(data.get("body") ?? "").trim();

    if (!title || !body) {
      errorEl.textContent = "タイトルと本文を入力してください。";
      errorEl.hidden = false;
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "投稿中…";

    try {
      const res = await fetch("/api/students/board", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ title, body }),
      });
      if (!res.ok) throw new Error("post_failed");

      form.reset();
      await loadPosts();
    } catch {
      errorEl.textContent = "投稿に失敗しました。もう一度お試しください。";
      errorEl.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "投稿する";
    }
  });

  loadPosts();
</script>
