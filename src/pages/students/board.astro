---
// src/pages/students/board.astro
import StudentLayout from "../../layouts/StudentLayout.astro";
---

<StudentLayout title="掲示板" description="城北情報大学の学生専用掲示板です。">
  <h1 class="text-2xl font-serif font-bold text-primary mb-1">掲示板</h1>
  <p class="text-xs text-gray-500 mb-6">スレッドを立てて、学生同士で自由に投稿・返信できます。</p>

  <details class="mb-6 border border-gray-300 bg-gray-50 rounded">
    <summary class="cursor-pointer select-none px-3 py-2 text-sm font-bold text-primary">
      ＋ 新しいスレッドを立てる
    </summary>
    <form id="post-form" class="px-3 pb-3 pt-1 space-y-2">
      <div class="flex flex-col sm:flex-row gap-2">
        <input
          type="text" id="handle" name="handle" placeholder="名無しさん"
          maxlength="30"
          class="w-full sm:w-40 border border-gray-300 rounded-none px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-secondary"
        />
        <input
          type="text" id="title" name="title" required maxlength="100" placeholder="スレッドタイトル"
          class="w-full border border-gray-300 rounded-none px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-secondary"
        />
      </div>
      <textarea
        id="body" name="body" required rows="3" maxlength="2000" placeholder="本文"
        class="w-full border border-gray-300 rounded-none px-2 py-1 text-sm font-mono leading-relaxed focus:outline-none focus:ring-1 focus:ring-secondary"
      ></textarea>
      <button
        type="submit" id="post-submit"
        class="bg-primary hover:bg-blue-800 text-white text-sm font-bold py-1 px-4 rounded-none transition disabled:opacity-60"
      >
        書き込む
      </button>
      <p id="post-error" role="alert" hidden class="text-xs text-red-600"></p>
    </form>
  </details>

  <div id="posts" class="border-t border-gray-300 text-sm">読み込み中…</div>
</StudentLayout>

<script>
  interface Post {
    id: number;
    student_email: string;
    display_name: string;
    title: string;
    body: string;
    created_at: string;
    reply_count: number;
    last_activity_at: string;
  }

  function escapeHtml(s: string): string {
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  function formatDate(iso: string): string {
    const d = new Date(iso.replace(" ", "T") + "Z");
    const jst = new Date(d.getTime() + 9 * 60 * 60 * 1000);
    const pad = (n: number) => String(n).padStart(2, "0");
    return `${jst.getFullYear()}/${pad(jst.getMonth() + 1)}/${pad(jst.getDate())} ${pad(jst.getHours())}:${pad(jst.getMinutes())}`;
  }

  async function loadPosts() {
    const el = document.getElementById("posts")!;
    try {
      const res = await fetch("/api/students/board");
      if (!res.ok) throw new Error("fetch_failed");
      const data: { posts: Post[] } = await res.json();

      if (data.posts.length === 0) {
        el.innerHTML = '<p class="text-xs text-gray-400 py-3">まだスレッドはありません。</p>';
        return;
      }

      el.innerHTML = data.posts
        .map(
          (p) => `
            <a href="/students/board/thread/?id=${p.id}"
               class="block px-1 py-2 border-b border-gray-200 hover:bg-gray-50">
              <span class="text-secondary">■</span>
              <span class="text-gray-900">${escapeHtml(p.title)}</span>
              <span class="text-gray-400 text-xs">(${p.reply_count})</span>
              <span class="block text-xs text-gray-400 mt-0.5">
                ${escapeHtml(p.display_name)} ／ ${formatDate(p.last_activity_at)}
              </span>
            </a>
          `
        )
        .join("");
    } catch {
      el.innerHTML = '<p class="text-xs text-red-500 py-3">投稿の取得に失敗しました。</p>';
    }
  }

  const form = document.getElementById("post-form") as HTMLFormElement;
  const submitBtn = document.getElementById("post-submit") as HTMLButtonElement;
  const errorEl = document.getElementById("post-error")!;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    errorEl.hidden = true;

    const data = new FormData(form);
    const title = String(data.get("title") ?? "").trim();
    const body = String(data.get("body") ?? "").trim();
    const handle = String(data.get("handle") ?? "").trim();

    if (!title || !body) {
      errorEl.textContent = "タイトルと本文を入力してください。";
      errorEl.hidden = false;
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "投稿中…";

    try {
      const res = await fetch("/api/students/board", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ title, body, handle_name: handle }),
      });
      if (!res.ok) throw new Error("post_failed");

      form.reset();
      await loadPosts();
    } catch {
      errorEl.textContent = "投稿に失敗しました。もう一度お試しください。";
      errorEl.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "書き込む";
    }
  });

  loadPosts();
</script>
