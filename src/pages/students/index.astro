---
// src/pages/students/index.astro
import StudentLayout from "../../layouts/StudentLayout.astro";
---

<StudentLayout title="学生ポータル" description="城北情報大学の学生専用ポータルです。">
  <h1 class="text-3xl font-serif font-bold text-primary mb-2">学生ポータル</h1>
  <p id="welcome" class="text-gray-500 mb-10">読み込み中…</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <a
      href="/students/lectures/"
      class="block bg-white p-8 rounded-xl shadow-md border-t-4 border-primary hover:shadow-lg transition"
    >
      <h2 class="text-xl font-bold text-gray-900 mb-2">講義動画</h2>
      <p class="text-gray-600 text-sm">
        各学部の講義動画をオンラインで視聴できます。
      </p>
    </a>
    <a
      href="/students/books/"
      class="block bg-white p-8 rounded-xl shadow-md border-t-4 border-secondary hover:shadow-lg transition"
    >
      <h2 class="text-xl font-bold text-gray-900 mb-2">書籍（学生割引）</h2>
      <p class="text-gray-600 text-sm">
        指定教科書を学生価格で購入できます。
      </p>
    </a>
  </div>
</StudentLayout>

<script>
  async function loadMe() {
    const el = document.getElementById("welcome")!;
    try {
      const res = await fetch("/api/students/me");
      if (!res.ok) throw new Error("not_authenticated");
      const data: { email: string } = await res.json();
      el.textContent = `ようこそ、${data.email} さん`;
    } catch {
      el.textContent = "ログイン情報を取得できませんでした。";
    }
  }
  loadMe();
</script>
