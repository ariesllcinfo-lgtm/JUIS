---
// src/pages/students/board/thread.astro
import StudentLayout from "../../../layouts/StudentLayout.astro";
---

<StudentLayout title="スレッド" description="城北情報大学の学生専用掲示板です。">
  <a href="/students/board/" class="text-sm text-secondary hover:underline">← 掲示板に戻る</a>

  <div id="thread-area" class="mt-6">読み込み中…</div>

  <h2 class="text-lg font-bold text-gray-900 mt-10 mb-4">返信</h2>
  <div id="replies-area">読み込み中…</div>

  <div class="bg-white rounded-xl shadow-md p-6 mt-6">
    <h3 class="text-sm font-bold text-gray-900 mb-3">返信する</h3>
    <form id="reply-form">
      <textarea
        id="reply-body"
        required
        rows="3"
        maxlength="2000"
        class="w-full border border-gray-300 rounded px-3 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-secondary"
      ></textarea>
      <button
        type="submit"
        id="reply-submit"
        class="mt-3 bg-primary hover:bg-blue-800 text-white font-bold py-2 px-6 rounded transition duration-300 disabled:opacity-60"
      >
        返信を投稿する
      </button>
      <p id="reply-error" role="alert" hidden class="text-sm text-red-600 mt-2"></p>
    </form>
  </div>
</StudentLayout>

<script>
  interface Thread {
    id: number;
    title: string;
    body: string;
    created_at: string;
    student_email: string;
    display_name: string;
  }
  interface Reply {
    id: number;
    thread_id: number;
    body: string;
    created_at: string;
    student_email: string;
    display_name: string;
  }

  const threadId = new URL(location.href).searchParams.get("id");
  let myEmail = "";

  function escapeHtml(s: string): string {
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  function formatDate(iso: string): string {
    const d = new Date(iso.replace(" ", "T") + "Z");
    const jst = new Date(d.getTime() + 9 * 60 * 60 * 1000);
    const pad = (n: number) => String(n).padStart(2, "0");
    return `${jst.getFullYear()}/${pad(jst.getMonth() + 1)}/${pad(jst.getDate())} ${pad(jst.getHours())}:${pad(jst.getMinutes())}`;
  }

  async function loadMyEmail() {
    try {
      const res = await fetch("/api/students/profile");
      if (!res.ok) return;
      const p: { email: string } = await res.json();
      myEmail = p.email;
    } catch {
      // 取得できなくても閲覧自体は継続できるようにする
    }
  }

  async function loadThread() {
    const threadEl = document.getElementById("thread-area")!;
    const repliesEl = document.getElementById("replies-area")!;

    if (!threadId) {
      threadEl.innerHTML = '<p class="text-sm text-red-500">スレッドIDが指定されていません。</p>';
      repliesEl.innerHTML = "";
      return;
    }

    try {
      const res = await fetch(`/api/students/board/thread?id=${encodeURIComponent(threadId)}`);
      if (!res.ok) throw new Error("not_found");
      const data: { thread: Thread; replies: Reply[] } = await res.json();

      const isThreadOwner = data.thread.student_email === myEmail;
      threadEl.innerHTML = `
        <div class="bg-white rounded-xl shadow-md p-6">
          <div class="flex justify-between items-start flex-wrap gap-2">
            <h1 class="text-2xl font-serif font-bold text-primary">${escapeHtml(data.thread.title)}</h1>
            ${isThreadOwner ? `<button id="delete-thread" class="text-xs text-red-500 border border-red-200 rounded px-3 py-1 hover:bg-red-50">スレッドを削除</button>` : ""}
          </div>
          <p class="text-gray-700 whitespace-pre-wrap my-4">${escapeHtml(data.thread.body)}</p>
          <p class="text-xs text-gray-400">${escapeHtml(data.thread.display_name)} ／ ${formatDate(data.thread.created_at)}</p>
        </div>
      `;

      document.getElementById("delete-thread")?.addEventListener("click", async () => {
        if (!confirm("このスレッドを削除しますか？返信もすべて削除されます。")) return;
        try {
          const res = await fetch(`/api/students/board/thread?id=${encodeURIComponent(threadId)}`, {
            method: "DELETE",
          });
          if (!res.ok) throw new Error("delete_failed");
          location.href = "/students/board/";
        } catch {
          alert("削除に失敗しました。");
        }
      });

      renderReplies(data.replies);
    } catch {
      threadEl.innerHTML = '<p class="text-sm text-red-500">スレッドが見つかりませんでした。</p>';
      repliesEl.innerHTML = "";
    }
  }

  function renderReplies(replies: Reply[]) {
    const el = document.getElementById("replies-area")!;
    if (replies.length === 0) {
      el.innerHTML = '<p class="text-sm text-gray-400">まだ返信はありません。</p>';
      return;
    }
    el.innerHTML = replies
      .map((r) => {
        const isOwner = r.student_email === myEmail;
        return `
          <div class="bg-white rounded-xl shadow-md p-5 mb-3">
            <div class="flex justify-between items-start gap-2">
              <p class="text-gray-700 whitespace-pre-wrap flex-1">${escapeHtml(r.body)}</p>
              ${isOwner ? `<button class="delete-reply text-xs text-red-500 border border-red-200 rounded px-2 py-1 hover:bg-red-50 flex-shrink-0" data-id="${r.id}">削除</button>` : ""}
            </div>
            <p class="text-xs text-gray-400 mt-2">${escapeHtml(r.display_name)} ／ ${formatDate(r.created_at)}</p>
          </div>
        `;
      })
      .join("");

    el.querySelectorAll<HTMLButtonElement>(".delete-reply").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("この返信を削除しますか？")) return;
        btn.disabled = true;
        try {
          const res = await fetch(`/api/students/board/replies?id=${btn.dataset.id}`, {
            method: "DELETE",
          });
          if (!res.ok) throw new Error("delete_failed");
          await loadThread();
        } catch {
          btn.disabled = false;
          alert("削除に失敗しました。");
        }
      });
    });
  }

  const replyForm = document.getElementById("reply-form") as HTMLFormElement;
  const replySubmit = document.getElementById("reply-submit") as HTMLButtonElement;
  const replyError = document.getElementById("reply-error")!;

  replyForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    replyError.hidden = true;

    const body = (document.getElementById("reply-body") as HTMLTextAreaElement).value.trim();
    if (!body || !threadId) return;

    replySubmit.disabled = true;
    try {
      const res = await fetch("/api/students/board/replies", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ thread_id: Number(threadId), body }),
      });
      if (!res.ok) throw new Error("reply_failed");
      replyForm.reset();
      await loadThread();
    } catch {
      replyError.textContent = "返信に失敗しました。もう一度お試しください。";
      replyError.hidden = false;
    } finally {
      replySubmit.disabled = false;
    }
  });

  (async () => {
    await loadMyEmail();
    await loadThread();
  })();
</script>
