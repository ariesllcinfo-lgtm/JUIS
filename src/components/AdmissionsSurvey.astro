---
// src/components/AdmissionsSurvey.astro
// 入試情報ページの適性診断インタラクティブ部分。
// /admissions/ への埋め込みと /admissions/survey/ の単独ページの
// 両方からこのコンポーネントを呼び出し、実装を一本化しています。
---

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8" id="survey">

      <!-- 質問中のみ表示する進捗ドット -->
      <div
        id="progress"
        hidden
        class="flex justify-center gap-2 mb-10"
        aria-hidden="true"
      >
        <span class="progress-dot h-1.5 w-8 rounded-full bg-gray-200"></span>
        <span class="progress-dot h-1.5 w-8 rounded-full bg-gray-200"></span>
        <span class="progress-dot h-1.5 w-8 rounded-full bg-gray-200"></span>
        <span class="progress-dot h-1.5 w-8 rounded-full bg-gray-200"></span>
        <span class="progress-dot h-1.5 w-8 rounded-full bg-gray-200"></span>
        <span class="progress-dot h-1.5 w-8 rounded-full bg-gray-200"></span>
      </div>

      <!-- Step: イントロ -->
      <div data-step="intro" class="text-center">
        <h1 class="text-4xl font-serif font-bold text-primary mb-4">
          あなたに合う学部診断
        </h1>
        <p class="text-gray-600 mb-8 max-w-xl mx-auto leading-relaxed">
          6つの質問に答えると、城北情報大学の6学部の中から、
          あなたに合いそうな学部が見えてきます。
        </p>
        <button
          type="button"
          id="start-btn"
          class="bg-primary hover:bg-blue-800 text-white font-bold py-3 px-8 rounded transition duration-300"
        >
          診断をはじめる
        </button>
        <p class="text-xs text-gray-400 mt-4">
          所要時間は1分ほどです。結果はその場で表示されます。
        </p>
      </div>

      <!-- Step: 質問（JSが1問ずつ描画） -->
      <div data-step="quiz" hidden>
        <h2
          id="quiz-question"
          class="text-2xl font-serif font-bold text-gray-900 mb-6"
        ></h2>
        <div
          id="quiz-options"
          role="group"
          aria-labelledby="quiz-question"
          class="flex flex-col divide-y divide-gray-100 rounded-lg shadow-md overflow-hidden bg-white"
        ></div>
        <button
          type="button"
          id="back-btn"
          class="mt-6 text-sm font-medium text-gray-500 hover:text-primary transition-colors"
        >
          &larr; 戻る
        </button>
      </div>

      <!-- Step: 属性情報の入力 -->
      <div data-step="info" hidden>
        <div class="bg-white p-8 rounded-xl shadow-md border-t-4 border-primary">
          <h2 class="text-2xl font-serif font-bold text-gray-900 mb-6">
            最後に、少しだけ教えてください
          </h2>
          <form id="info-form" novalidate class="space-y-5">
            <div>
              <label
                for="education"
                class="block text-sm font-medium text-gray-700 mb-1"
                >学歴</label
              >
              <select
                id="education"
                name="education"
                required
                class="w-full border border-gray-300 rounded px-3 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-secondary"
              >
                <option value="">選択してください</option>
                <option>高校生</option>
                <option>高卒・浪人中</option>
                <option>大学生</option>
                <option>大学卒業</option>
                <option>社会人</option>
                <option>その他</option>
              </select>
            </div>

            <div>
              <label
                for="faculty"
                class="block text-sm font-medium text-gray-700 mb-1"
                >出身・在学中の学校／学部学科（任意）</label
              >
              <input
                type="text"
                id="faculty"
                name="faculty"
                autocomplete="off"
                placeholder="例：普通科、〇〇高校 など"
                class="w-full border border-gray-300 rounded px-3 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-secondary"
              />
            </div>

            <div>
              <label
                for="occupation"
                class="block text-sm font-medium text-gray-700 mb-1"
                >現在のご職業</label
              >
              <select
                id="occupation"
                name="occupation"
                required
                class="w-full border border-gray-300 rounded px-3 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-secondary"
              >
                <option value="">選択してください</option>
                <option>学生</option>
                <option>会社員</option>
                <option>公務員</option>
                <option>自営業・フリーランス</option>
                <option>その他</option>
              </select>
            </div>

            <label class="flex items-start gap-2 text-sm text-gray-600">
              <input type="checkbox" id="wants-email" class="mt-0.5" />
              <span>診断結果をメールで受け取る</span>
            </label>

            <div id="email-field" hidden>
              <label
                for="contact_email"
                class="block text-sm font-medium text-gray-700 mb-1"
                >メールアドレス</label
              >
              <input
                type="email"
                id="contact_email"
                name="contact_email"
                autocomplete="email"
                placeholder="example@juis.ac.jp"
                class="w-full border border-gray-300 rounded px-3 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-secondary"
              />
            </div>

            <label class="flex items-start gap-2 text-sm text-gray-600">
              <input type="checkbox" id="consent" required class="mt-0.5" />
              <span>
                <a href="/privacy/" class="text-primary underline"
                  >プライバシーポリシー</a
                >に同意のうえ、回答内容の送信に同意する
              </span>
            </label>

            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-primary hover:bg-blue-800 text-white font-bold py-3 px-4 rounded transition duration-300 disabled:opacity-60 disabled:cursor-not-allowed"
            >
              診断結果を見る
            </button>
            <p
              id="form-error"
              role="alert"
              hidden
              class="text-sm text-red-600"
            ></p>
          </form>
        </div>
      </div>

      <!-- Step: 結果 -->
      <div data-step="result" hidden>
        <div id="result-panel" class="rounded-xl p-10 text-center text-white"></div>
      </div>

      <noscript>
        <p class="bg-white border border-gray-200 rounded p-4 text-sm text-gray-600">
          この診断コンテンツのご利用には、ブラウザのJavaScriptを
          有効にしていただく必要があります。
        </p>
      </noscript>
    </div>

<style>
  /* ステップ切り替え時の簡単なフェード（1回限りの遷移、装飾目的の多用はしない） */
  [data-step] {
    animation: step-in 0.25s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-step] {
      animation: none;
    }
  }
  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  type FacultyKey = "LE" | "WF" | "IP" | "CA" | "AG" | "DS";

  interface Question {
    q: string;
    options: { text: string; key: FacultyKey }[];
  }

  const QUESTIONS: Question[] = [
    {
      q: "気になるニュースは？",
      options: [
        { text: "法律改正や経済政策のニュース", key: "LE" },
        { text: "介護・福祉制度に関する話題", key: "WF" },
        { text: "新商品のヒットやブランド戦略", key: "IP" },
        { text: "情報格差やユニバーサルデザインの話題", key: "CA" },
        { text: "気候変動と食料生産の関係", key: "AG" },
        { text: "新しい建築やプロダクトデザイン", key: "DS" },
      ],
    },
    {
      q: "友人からよく頼られることは？",
      options: [
        { text: "契約やルールまわりの相談", key: "LE" },
        { text: "悩み相談の聞き役", key: "WF" },
        { text: "お得な買い物や値段交渉のアドバイス", key: "IP" },
        { text: "難しい説明のかみ砕き役", key: "CA" },
        { text: "植物やペットの世話の相談", key: "AG" },
        { text: "部屋のレイアウトやコーディネートの相談", key: "DS" },
      ],
    },
    {
      q: "得意だった科目・分野は？",
      options: [
        { text: "政治経済・法律", key: "LE" },
        { text: "保健・家庭科", key: "WF" },
        { text: "商業・簿記", key: "IP" },
        { text: "国語・語学", key: "CA" },
        { text: "生物・地学", key: "AG" },
        { text: "美術・技術", key: "DS" },
      ],
    },
    {
      q: "やってみたい仕事のイメージは？",
      options: [
        { text: "公務員や企業の法務・経営企画", key: "LE" },
        { text: "福祉施設や医療機関でのケア", key: "WF" },
        { text: "商社やメーカーでの商品企画", key: "IP" },
        { text: "通訳・字幕制作・広報", key: "CA" },
        { text: "農業法人や環境コンサル", key: "AG" },
        { text: "グラフィックや空間のデザイナー", key: "DS" },
      ],
    },
    {
      q: "つい没頭してしまう作業は？",
      options: [
        { text: "資料を整理してルールを組み立てる", key: "LE" },
        { text: "人の話にじっくり付き合う", key: "WF" },
        { text: "市場調査やプレゼン資料づくり", key: "IP" },
        { text: "情報をわかりやすく翻訳・要約する", key: "CA" },
        { text: "植物の成長や環境データの記録", key: "AG" },
        { text: "手を動かしてものを作る・描く", key: "DS" },
      ],
    },
    {
      q: "大事にしたい価値観は？",
      options: [
        { text: "公正さ・ルール", key: "LE" },
        { text: "思いやり・支え合い", key: "WF" },
        { text: "独創性・価値創造", key: "IP" },
        { text: "誰も取り残さない伝え方", key: "CA" },
        { text: "自然との共生・持続可能性", key: "AG" },
        { text: "美しさ・表現", key: "DS" },
      ],
    },
  ];

  const RESULTS: Record<
    FacultyKey,
    { name: string; color: string; desc: string; href: string }
  > = {
    LE: {
      name: "情報法経学部",
      color: "#1e3a8a",
      desc: "論理的にものごとを整理し、ルールや制度を通じて社会の土台をつくる資質があります。データと制度を武器に、公正な仕組みづくりに関わる仕事が向いています。",
      href: "/articles/t_umzijj18/",
    },
    WF: {
      name: "社会福祉学部",
      color: "#b45253",
      desc: "人に寄り添う力に長けています。福祉・医療・教育の現場で、目の前の誰かを支える仕事にやりがいを感じられるはずです。",
      href: "/articles/xlhxrd8947_s/",
    },
    IP: {
      name: "知的財産商学部",
      color: "#8a6d3b",
      desc: "アイデアを価値に変えるセンスの持ち主です。ブランディングや商品企画など、創造と戦略を両立させる仕事に力を発揮できます。",
      href: "/articles/vkv-6xph92c2/",
    },
    CA: {
      name: "コミュニケーション保障学部",
      color: "#2f6f6f",
      desc: "「伝える」ことへの意識が高いタイプです。誰にでも届く情報発信や、言語・文化の壁を越える仕事で強みを発揮できます。",
      href: "/articles/sqb7dl-8nnz/",
    },
    AG: {
      name: "システム農学部",
      color: "#3f6b34",
      desc: "自然と技術をつなぐ発想の持ち主です。環境や食のシステムを、テクノロジーの視点から支える仕事にフィットします。",
      href: "/articles/3abso_16j3c/",
    },
    DS: {
      name: "College of Design",
      color: "#6b3f8a",
      desc: "美意識と表現力が武器です。ものづくりや空間・体験のデザインを通じて、才能を発揮できるでしょう。",
      href: "/articles/lcp9_i4umj/",
    },
  };

  const FACULTY_ORDER: FacultyKey[] = ["LE", "WF", "IP", "CA", "AG", "DS"];

  const steps = {
    intro: document.querySelector<HTMLElement>('[data-step="intro"]')!,
    quiz: document.querySelector<HTMLElement>('[data-step="quiz"]')!,
    info: document.querySelector<HTMLElement>('[data-step="info"]')!,
    result: document.querySelector<HTMLElement>('[data-step="result"]')!,
  };

  const progressEl = document.getElementById("progress")!;
  const dots = Array.from(
    progressEl.querySelectorAll<HTMLElement>(".progress-dot")
  );
  const questionEl = document.getElementById("quiz-question")!;
  const optionsEl = document.getElementById("quiz-options")!;
  const backBtn = document.getElementById("back-btn")!;
  const startBtn = document.getElementById("start-btn")!;
  const infoForm = document.getElementById("info-form") as HTMLFormElement;
  const wantsEmailEl = document.getElementById(
    "wants-email"
  ) as HTMLInputElement;
  const emailFieldEl = document.getElementById("email-field")!;
  const formErrorEl = document.getElementById("form-error")!;
  const submitBtn = document.getElementById(
    "submit-btn"
  ) as HTMLButtonElement;
  const resultPanel = document.getElementById("result-panel")!;

  const sessionId =
    "sid_" + Math.random().toString(36).slice(2) + Date.now().toString(36);

  let currentQuestion = 0;
  const answers: { q: string; a: string; key: FacultyKey }[] = [];

  function showStep(name: keyof typeof steps) {
    for (const key of Object.keys(steps) as (keyof typeof steps)[]) {
      steps[key].hidden = key !== name;
    }
    progressEl.hidden = name !== "quiz";
  }

  function renderQuestion() {
    const question = QUESTIONS[currentQuestion];
    questionEl.textContent = question.q;
    optionsEl.innerHTML = "";

    question.options.forEach((opt) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className =
        "w-full text-left px-5 py-4 hover:bg-blue-50 transition-colors text-gray-700 font-medium";
      btn.textContent = opt.text;
      btn.addEventListener("click", () => selectAnswer(opt.text, opt.key));
      optionsEl.appendChild(btn);
    });

    dots.forEach((dot, i) => {
      dot.className =
        "progress-dot h-1.5 w-8 rounded-full " +
        (i < currentQuestion
          ? "bg-primary"
          : i === currentQuestion
            ? "bg-secondary"
            : "bg-gray-200");
    });

    backBtn.hidden = currentQuestion === 0;
  }

  function selectAnswer(text: string, key: FacultyKey) {
    answers[currentQuestion] = { q: QUESTIONS[currentQuestion].q, a: text, key };

    if (currentQuestion < QUESTIONS.length - 1) {
      currentQuestion += 1;
      renderQuestion();
    } else {
      showStep("info");
    }
  }

  startBtn.addEventListener("click", () => {
    currentQuestion = 0;
    showStep("quiz");
    renderQuestion();
  });

  backBtn.addEventListener("click", () => {
    if (currentQuestion === 0) {
      showStep("intro");
      return;
    }
    currentQuestion -= 1;
    renderQuestion();
  });

  wantsEmailEl.addEventListener("change", () => {
    emailFieldEl.hidden = !wantsEmailEl.checked;
    const emailInput = document.getElementById(
      "contact_email"
    ) as HTMLInputElement;
    emailInput.required = wantsEmailEl.checked;
  });

  function computeResult(): FacultyKey {
    const tally: Record<FacultyKey, number> = {
      LE: 0,
      WF: 0,
      IP: 0,
      CA: 0,
      AG: 0,
      DS: 0,
    };
    answers.forEach((a) => {
      tally[a.key] += 1;
    });
    let best: FacultyKey = FACULTY_ORDER[0];
    for (const key of FACULTY_ORDER) {
      if (tally[key] > tally[best]) best = key;
    }
    return best;
  }

  function renderResult(key: FacultyKey) {
    const r = RESULTS[key];
    resultPanel.style.backgroundColor = r.color;
    resultPanel.innerHTML = `
      <p class="text-sm text-white/80 mb-2">診断結果</p>
      <h2 class="text-3xl font-serif font-bold mb-4">
        あなたには「${r.name}」が向いています
      </h2>
      <p class="text-white/90 leading-relaxed mb-8 max-w-xl mx-auto">${r.desc}</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="${r.href}"
          class="inline-flex bg-white font-bold py-3 px-6 rounded-full"
          style="color: ${r.color}"
        >学部の詳細を見る</a>
        <a
          href="/admissions/"
          class="inline-flex border border-white/60 text-white font-bold py-3 px-6 rounded-full"
        >入試情報トップへ戻る</a>
      </div>
    `;
    showStep("result");
  }

  infoForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    formErrorEl.hidden = true;

    const data = new FormData(infoForm);
    const consent = (document.getElementById("consent") as HTMLInputElement)
      .checked;

    if (!consent) {
      formErrorEl.textContent = "プライバシーポリシーへの同意が必要です。";
      formErrorEl.hidden = false;
      return;
    }

    if (wantsEmailEl.checked && !data.get("contact_email")) {
      formErrorEl.textContent = "メールアドレスを入力してください。";
      formErrorEl.hidden = false;
      return;
    }

    const facultyKey = computeResult();

    submitBtn.disabled = true;
    submitBtn.textContent = "送信中…";

    try {
      const res = await fetch("/api/submissions", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          session_id: sessionId,
          education: data.get("education"),
          faculty: data.get("faculty") || null,
          occupation: data.get("occupation"),
          personality_type: RESULTS[facultyKey].name,
          answers,
          contact_email: wantsEmailEl.checked
            ? data.get("contact_email")
            : null,
          consent: 1,
        }),
      });

      if (!res.ok) throw new Error("submit_failed");

      renderResult(facultyKey);
    } catch (err) {
      formErrorEl.textContent =
        "送信に失敗しました。通信環境をご確認のうえ、もう一度お試しください。";
      formErrorEl.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "診断結果を見る";
    }
  });
</script>
