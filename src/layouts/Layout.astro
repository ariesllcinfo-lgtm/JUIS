---
import "../styles/global.css";
// schema: そのページ固有の構造化データ（Course/Person/Article等）を1件、または複数件は配列で渡す。
// 渡さないページではサイト全体の CollegeOrUniversity のみが出力される。
interface Props { title?: string; description?: string; image?: string; schema?: Record<string, unknown> | Record<string, unknown>[]; }
const {
  title = "城北情報大学",
  description = "城北情報大学公式サイト",
  image = "/images/ogp-default.jpg",
  schema,
} = Astro.props;
const path = Astro.url.pathname;
const pageTitle = `${title} | Johoku University of Information Studies`;
// microCMSのeyecatch画像は既に絶対URL、それ以外（デフォルト画像等）はサイトURLからの相対パスとして解決する
const ogImageUrl = image.startsWith("http") ? image : new URL(image, Astro.site).toString();
const canonicalUrl = new URL(path, Astro.site).toString();

// サイト全体で共通のCollegeOrUniversity。answer engineが「城北情報大学とは何か」を
// 単独で判断できるよう、どのページにも必ず埋め込む。
const universitySchema = {
  "@context": "https://schema.org",
  "@type": "CollegeOrUniversity",
  "name": "城北情報大学",
  "alternateName": "Johoku University of Information Studies",
  "url": Astro.site?.toString(),
  "logo": new URL("/header-logo.png", Astro.site).toString(),
  "address": {
    "@type": "PostalAddress",
    "postalCode": "170-0000",
    "addressRegion": "東京都",
    "addressLocality": "豊島区",
    "streetAddress": "城北台1-2-3",
    "addressCountry": "JP",
  },
};
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchemas = [universitySchema, ...pageSchemas];
const nav = [
  { href: "/", label: "ホーム" },
  { href: "/academics/", label: "学部・大学院" },
  { href: "/research/", label: "教育・研究" },
  { href: "/about/", label: "大学紹介" },
  { href: "/admissions/", label: "入試情報" },
  { href: "/career/", label: "就職・キャリア支援" },
];
---
<!doctype html>
<html lang="ja" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{pageTitle}</title>
  <link rel="canonical" href={canonicalUrl} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- OGP（アイキャッチ画像。ページ側でimageを指定しなければ既定の外観写真を使用） -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="城北情報大学" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content="ja_JP" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;600;900&display=swap" rel="stylesheet" />

  <!-- 構造化データ（AEO/SEO）：サイト全体のCollegeOrUniversity + ページ固有のschema -->
  {allSchemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body class="font-sans text-gray-800 bg-light antialiased flex flex-col min-h-screen">
<header class="fixed w-full z-50 bg-white/95 backdrop-blur shadow-sm border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="flex justify-between items-center h-20">
    <a href="/" class="flex-shrink-0 flex items-center gap-3">
      <img src="/header-logo.png" alt="城北情報大学" class="h-16 w-16 object-contain" />
      <div><h1 class="font-serif font-bold text-xl tracking-wider text-primary leading-tight">城北情報大学</h1><p class="text-[10px] text-gray-500 tracking-widest uppercase">Johoku University of Information Studies</p></div>
    </a>
    <div class="hidden md:flex items-center gap-8">
      <nav class="flex space-x-8 h-full items-center">
        {nav.map(item => <a href={item.href} class:list={["nav-link h-full px-1 flex items-center text-gray-600 hover:text-primary transition-colors text-sm font-medium", path===item.href && "active-nav"]}>{item.label}</a>)}
      </nav>
      <a href="/students/" class="inline-flex items-center text-sm font-bold text-white bg-secondary hover:bg-blue-400 px-4 py-2 rounded-full transition">在学生の方</a>
    </div>
    <button id="mobile-menu-btn" class="md:hidden text-gray-600 hover:text-primary" aria-label="メニューを開く" aria-expanded="false"><svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg></button>
  </div></div>
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100"><div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">{nav.map(item => <a href={item.href} class="block px-3 py-2 text-base font-medium text-gray-800 hover:bg-gray-50 hover:text-primary">{item.label}</a>)}<a href="/students/" class="block mt-2 px-3 py-2 text-center text-base font-bold text-white bg-secondary rounded">在学生の方</a></div></div>
</header>
<main class="flex-grow pt-20"><slot /></main>
<footer class="bg-dark text-gray-400 py-12 border-t border-gray-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8 border-b border-gray-800 pb-8">
<!-- Brand -->
<div class="flex flex-col">
<div class="flex items-center gap-2 mb-4">
<img src="/footer-logo.png" alt="城北情報大学" class="h-10 w-10 object-contain" />
<h2 class="font-serif font-bold text-xl text-white">城北情報大学</h2>
</div>
<p class="text-xs mb-2">〒170-0000 東京都豊島区城北台1-2-3</p>
<p class="text-xs mb-4">Johoku University of Information Studies</p>
</div>
<!-- Links 1 -->
<div class="flex flex-col space-y-2 text-sm">
<a class="hover:text-white transition" href="/academics/">学部・大学院</a>
<a class="hover:text-white transition" href="/faculty/">教員紹介</a>
<a class="hover:text-white transition" href="/research/">教育・研究</a>
<a class="hover:text-white transition" href="/institutes/">附属機関</a>
<a class="hover:text-white transition" href="/about/">大学紹介</a>
<a class="hover:text-white transition" href="/about/recruitment/">教員採用情報</a>
<a class="hover:text-white transition" href="#">キャンパスライフ</a>
</div>
<!-- Links 2 -->
<div class="flex flex-col space-y-2 text-sm">
<a class="hover:text-white transition" href="/admissions/">入試情報</a>
<a class="hover:text-white transition" href="/students/">在学生の方</a>
<a class="hover:text-white transition" href="/career/">就職・キャリア支援</a>
<a class="hover:text-white transition" href="#">図書館・施設案内</a>
<a class="hover:text-white transition" href="#">お問い合わせ</a>
</div>
</div>
<div class="flex flex-col md:flex-row justify-between items-center text-xs">
<div class="flex space-x-4 mb-4 md:mb-0">
<a class="hover:text-white transition" href="#">サイトポリシー</a>
<a class="hover:text-white transition" href="#">プライバシーポリシー</a>
</div>
<p>© 2026 Johoku University of Information Studies. All rights reserved.</p>
</div>
</div>
</footer>
<script>
 const button=document.getElementById('mobile-menu-btn'); const menu=document.getElementById('mobile-menu');
 button?.addEventListener('click',()=>{const hidden=menu?.classList.toggle('hidden');button.setAttribute('aria-expanded',String(!hidden));});
</script>
</body></html>
