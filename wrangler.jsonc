{
  "name": "juis",
  "compatibility_date": "2026-08-28",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/students/creator/works/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "juis-admissions",
      "database_id": "3431b03d-a517-43e8-954c-ae9d8886467b"
    },
    {
      "binding": "CREATOR_DB",
      "database_name": "juis-db",
      "database_id": "19a008de-60f3-47ff-90d6-c5c9fcafdec4"
    }
  ]
}
