{
  "name": "juis",
  "compatibility_date": "2026-08-28",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/students/creator/works/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "juis-admissions",
      "database_id": "3431b03d-a517-43e8-954c-ae9d8886467b"
    },
    {
      "binding": "CREATOR_DB",
      "database_name": "juis-db",
      "database_id": "19a008de-60f3-47ff-90d6-c5c9fcafdec4"
    }
  ],
  "vars": {
    "LIBRARY_ACCESS_ISSUER": "https://silent-base-03f8.cloudflareaccess.com",
    "LIBRARY_STUDENT_AUD": "df70994cfd22e7320e5524e97cb244e5ac61e62f12b5c7c436ca7dcbf04627e2",
    "LIBRARY_ADMIN_AUD": "d908dd294b8562a0227c8161eb1e4e80d88e1e95771917c52d8acae5b8a313d0"
  }
}
